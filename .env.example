# ==========================================
# EchoTune Discord Music Bot - Environment Configuration
# ==========================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Discord Bot Credentials
# Obtain from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Default Bot Settings
DEFAULT_PREFIX=!
LOG_LEVEL=info

# Database (PostgreSQL) - Required for Phase 4+
DATABASE_URL=postgresql://echotune:echotunepass@localhost:5432/echotunedb?schema=public

# Redis (Caching & Realtime State) - Required for Phase 4+
REDIS_URL=redis://localhost:6379

# Lavalink v4 Server Connection - Required for Phase 2+
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# Spotify API Credentials (Metadata resolution) - Required for Phase 3+
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Fastify API & Dashboard - Required for Phase 6+
API_PORT=3000
API_HOST=0.0.0.0
