{
  "name": "voidtune-bot",
  "version": "2.0.0",
  "description": "Scalable, modular, multi-guild Discord music bot platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop voidtune",
    "pm2:restart": "pm2 restart voidtune",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs voidtune",
    "pm2:save": "pm2 save"
  },
  "keywords": [
    "discord",
    "music-bot",
    "lavalink",
    "shoukaku",
    "typescript"
  ],
  "author": "VoidTune Team",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "pm2": "^5.4.3",
    "shoukaku": "^4.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
